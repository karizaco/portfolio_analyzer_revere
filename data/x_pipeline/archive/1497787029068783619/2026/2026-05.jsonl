{"schema":"x-post-1","post_id":"2055976631831806418","user_id":"1497787029068783619","handle":"trader_gu","created_at":"2026-05-17T11:40:01.000Z","kind":"original","text":"Sharing your trades publicly can build credibility.\n\nIt can also quietly destroy your edge.\n\nWhen you post a trade, the outcome stops being data in your journal.\n\nIt becomes a statement. People react. They judge. They have opinions.\n\nAnd those opinions can change the way you think about your own trading.\n\nDuring drawdowns, a loop forms:\n- You post a losing trade\n- You get negative feedback\n- You start questioning your setup\n- You tweak your rules\n- Your data gets corrupted\n\nBy the time you notice it, the damage is already in your journal.\n\nYour edge is more important than your audience.","text_source":"note_tweet","lang":"en","conversation_id":"2055976631831806418","in_reply_to_post_id":null,"in_reply_to_user_id":null,"self_thread":false,"quoted_post_id":null,"reposted_post_id":null,"referenced":[],"entities":{"cashtags":[],"hashtags":[],"mentions":[],"urls":[]},"media":[{"media_key":"3_2055976338033418240","type":"photo","url":"https://pbs.twimg.com/media/HIhLlh8XIAA6uRD.png","preview_url":"","width":3200,"height":1800,"alt_text":""}],"edit":{"history_ids":["2055976631831806418"],"is_earliest":true},"metrics_first_seen":{"likes":2,"reposts":0,"replies":1,"quotes":0,"views":88,"bookmarks":0,"observed_at":"2026-11-28T15:05:18.414Z"},"fetched_via":"api_v2","fidelity":"full","first_seen_at":"2026-11-28T15:05:18.414Z"}
{"schema":"x-post-1","post_id":"2055976784386990223","user_id":"1497787029068783619","handle":"trader_gu","created_at":"2026-05-17T11:40:38.000Z","kind":"reply","text":"","text_source":"text","lang":"zxx","conversation_id":"2055976631831806418","in_reply_to_post_id":"2055976631831806418","in_reply_to_user_id":"1497787029068783619","self_thread":true,"quoted_post_id":null,"reposted_post_id":null,"referenced":[{"type":"replied_to","post_id":"2055976631831806418","handle":"trader_gu","created_at":"2026-05-17T11:40:01.000Z","text":"Sharing your trades publicly can build credibility.\n\nIt can also quietly destroy your edge.\n\nWhen you post a trade, the outcome stops being data in your journal.\n\nIt becomes a statement. People react. They judge. They have opinions.\n\nAnd those opinions can change the way you think about your own trading.\n\nDuring drawdowns, a loop forms:\n- You post a losing trade\n- You get negative feedback\n- You start questioning your setup\n- You tweak your rules\n- Your data gets corrupted\n\nBy the time you notice it, the damage is already in your journal.\n\nYour edge is more important than your audience."}],"entities":{"cashtags":[],"hashtags":[],"mentions":[],"urls":["https://www.tradergu.com/posts/sharing-trades-publicly/"]},"media":[],"edit":{"history_ids":["2055976784386990223"],"is_earliest":true},"metrics_first_seen":{"likes":1,"reposts":0,"replies":0,"quotes":0,"views":50,"bookmarks":0,"observed_at":"2026-11-28T15:05:20.117Z"},"fetched_via":"api_v2","fidelity":"full","first_seen_at":"2026-11-28T15:05:20.117Z"}
