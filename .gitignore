node_modules/
eng.traineddata
# Local credentials. The values live here and are never committed.
# .env.example is tracked and holds no secrets.
.env
.env.local
.env.*.local
data/extract_run.log
# Ignore video_pipeline contents, but keep state DB + transcripts trackable.
# (Must use trailing /* so git can re-include children; ignoring the dir itself blocks negation.)
data/video_pipeline/*
!data/video_pipeline/state.sqlite
!data/video_pipeline/transcripts/
!data/video_pipeline/transcripts/**
data/video_pipeline_*/
data/video_ocr_probe/
data/my_videos/
data/my_videos_*/
data/my_videos_v*/
data/price_cache/
sample_screenshots.lnk
# Default output of discord browser ingest debug runs
discord_dump.jsonl
browser_session_*.json
# Heavy per-frame PNGs from OCR scans — reproducible from probe logs
data/video_scan_*/fix-final/screenshots/
data/video_scan_*/**/ocr_probe/frames/
# Test runs and probes — temporary artifacts
data/video_scan_test/
# The same family, spelled out: a one-off crop/frame experiment. Nothing
# outside the directory references it, and the frames it was cut from live
# under the gitignored data/video_scan_test/ tree.
data/video_scan_1080p_test/
# Captured stdout of a one-off run. Every video id in these is already in
# the catalog, and the tool that produced them is tools/fetchCaptions.js --
# its real output goes to data/video_pipeline/transcripts/.
data/fetch_captions_*.log
# Scratch written at the root of data/ by one-off download campaigns: the
# stdout of the parallel workers, and the id slices that split the work
# between them. Every id in them is in the catalog.
data/.download_logs/
data/.download_slices.json
data/_*.txt
# Scratch output roots the e2e scan tests create under data/. They are removed
# in a finally block, but an interrupted run leaves them behind.
data/video_ocr_e2e_*/
data/video_ocr_chart_e2e_*/
**/__pycache__/
data/discord_pipeline/.cache/
# Bundled binaries
tools/ffmpeg.exe
tools/ffprobe.exe
# Plan files
*.plan.md
CLAUDE_RAPPEL_PLAN.md
# Scratch written at the repository ROOT during one-off investigations. The
# findings live in docs/ and in the src/ modules; the scratch itself is
# recoverable from git history, so it does not belong in the tree.
# Anchored at the root on purpose: tools/ and test/ keep their own
# underscore-prefixed helpers on purpose.
/PLAN_*.md
/Usersadmin.claudeplans*.md
/*.log
/_*.js
/_*.py
/debug_*.py
# One-off diagnostic scripts written at the repo root while working out the
# Qullamaggie position-list geometry. Their findings live in
# docs/qmg-positions-layout-findings.md and the src/video/position*.js modules.
dbg_*.js
dbg_*.cjs
# Throwaway diagnostic scripts written while chasing a specific bug.
*_tmp.js
*_tmp.cjs
*Tmp.js
# Manual crop of position-panel regions, kept only for visual inspection.
# No tool writes these; the frames they were cut from live under the
# gitignored data/video_scan_test/ tree.
data/qmg_corpus_crops/
# Labelled corpus built by tools/buildPositionCorpus.js. It is a tool output,
# so it stays out of git by default — BUT it cannot be rebuilt from a clean
# clone, because the frames it was measured from live under the gitignored
# data/video_scan_test/ tree. Once it has entries, commit it explicitly:
#   git add -f data/qmg_position_corpus.json
data/qmg_position_corpus.json
# Channel listings and the work lists built from them, used to fill in the
# upload_date of videos the catalog could not resolve. Both are regenerated
# in a couple of minutes with one yt-dlp --flat-playlist call.
data/catalog_flat/
# The OCR of the frames tools/evalRevere.js replays. It is a cache, written by
#   node tools/evalRevere.js --replay --ocr-cache data/revere_ocr_cache.json
# and its only purpose is to let two parser versions be compared over the SAME
# OCR -- Tesseract is not deterministic, so a re-OCR would mix parser change
# with OCR noise. It cannot be rebuilt on a fresh clone (the media is not in
# git), so commit it explicitly if it is ever worth sharing:
#   git add -f data/revere_ocr_cache.json
data/revere_ocr_cache.json
# Sevcik derived rollups/report (regenerated from DB + transcripts).
# Catalog export and transcripts ARE tracked:
#   data/sevcik_catalog.json
#   data/video_pipeline/transcripts/*.json
# Signals/setups live in tracked state.sqlite; CSV/JSON/HTML rollups stay local.
data/sevcik_signals.csv
data/sevcik_daily_summary.csv
data/sevcik_ticker_summary.csv
data/sevcik_setups.csv
data/sevcik_setup_daily_summary.csv
data/sevcik_setup_ticker_summary.csv
data/sevcik_signals.json
data/sevcik_report.html
data/sevcik_outcomes.csv
data/sevcik_outcomes.json
data/sevcik_outcome_ticker_summary.csv

# The prefilter-resolution sweep's output. The TWO canonical result files are
# committed explicitly (git add -f), because they are the measurement record
# behind the numbers CLAUDE.md quotes, and they cannot be rebuilt on a fresh
# clone -- the probe logs and the media they measure are both untracked.
# Every OTHER sweep file is an intermediate run (a partial pass, a single-date
# probe, a print check) and stays out.
data/prefilter_resolution_sweep.json
data/prefilter_resolution_sweep_*.json
!data/prefilter_resolution_sweep_2022.json
!data/prefilter_resolution_sweep_2023.json

# One-off Sevcik fetch stdout (scratch). Transcripts are tracked under
# data/video_pipeline/transcripts/.
data/sevcik_fetch_log.txt
