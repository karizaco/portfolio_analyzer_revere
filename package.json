{
  "name": "portfolio-analyzer-revere",
  "version": "0.1.0",
  "private": true,
  "description": "Extract portfolio snapshots from Revere screenshots into CSV files.",
  "type": "commonjs",
  "scripts": {
    "discover": "node src/index.js discover",
    "extract": "node src/index.js extract",
    "extract:sample": "node src/index.js extract --limit 5",
    "whiteboard:extract": "node src/index.js extract-whiteboard",
    "performance": "node src/index.js performance",
    "report": "node src/index.js report",
    "video:init": "node tools/runWhiteboardWorker.js init",
    "video:status": "node tools/runWhiteboardWorker.js status",
    "video:catalog": "node tools/runWhiteboardWorker.js catalog",
    "video:catalog:qmg": "node tools/runWhiteboardWorker.js catalog --channel qullamaggie --source-url https://www.youtube.com/@Qullamaggie/videos",
    "video:download": "node tools/runWhiteboardWorker.js download",
    "video:download-hires": "node tools/downloadHiresBatch.js",
    "video:download-hires:30": "node tools/downloadHiresBatch.js --limit 30 --height 720",
    "video:stamp-types": "node tools/stampExistingProbeLogs.js",
    "video:stamp-types:reclassify": "node tools/stampExistingProbeLogs.js --reclassify",
    "video:ocr-parallel": "bash tools/parallelOcrScan.sh",
    "video:ocr-parallel:qmg": "CHANNEL=qullamaggie PREFILTER_PROFILE=chart_stream BASENAME=qmg CHART_STREAM_PARSER=1 bash tools/parallelOcrScan.sh",
    "video:import-local": "node tools/runWhiteboardWorker.js import-local",
    "video:scan": "node tools/runWhiteboardWorker.js scan",
    "video:scan-ocr": "node tools/scanVideoWithOcr.js",
    "video:scan-ocr:qmg": "node tools/scanVideoWithOcr.js --prefilter-profile chart_stream --basename qmg --chart-stream-parser",
    "video:catalog-list": "node tools/listCatalog.js",
    "video:fetch-captions": "node tools/fetchCaptions.js",
    "video:fetch-captions:qmg": "CHANNEL=qullamaggie node tools/fetchCaptions.js",
    "video:fetch-captions:revere": "CHANNEL=revere node tools/fetchCaptions.js",
    "fixture:build-synthetic": "node tools/buildSyntheticWhiteboardVideo.js",
    "fixture:build-synthetic:qmg": "node tools/buildSyntheticChartStreamVideo.js",
    "video:dryrun-yt": "bash tools/dryrun_yt_dlp_pipeline.sh",
    "video:dryrun-local": "bash tools/dryrun_python_worker_pipeline.sh",
    "video:dryrun": "bash tools/dryrun_full_pipeline.sh",
    "discord:init": "node tools/runDiscordIngest.js init",
    "discord:add-source": "node tools/runDiscordIngest.js add-source",
    "discord:ingest": "node tools/runDiscordIngest.js ingest",
    "discord:extract-tickers": "node tools/runDiscordIngest.js extract-tickers",
    "discord:list": "node tools/runDiscordIngest.js list",
    "discord:status": "node tools/runDiscordIngest.js status",
    "discord:catalog": "node tools/listDiscordCatalog.js"
  },
  "dependencies": {
    "sharp": "^0.34.3",
    "tesseract.js": "^6.0.1"
  }
}
