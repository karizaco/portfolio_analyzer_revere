# Copy this file to `.env` and fill in the values you need.
#
# `.env` is GITIGNORED and is never committed. `.env.example` is tracked
# and holds no secrets.

# Deepgram API key. Enables the transcription fallback for the videos
# YouTube has no auto-captions for.
#
# Get one at https://console.deepgram.com/signup
# The Sevcik channel is Czech, so DEEPGRAM_LANGUAGE is cs by default.
DEEPGRAM_API_KEY=

# Optional: the Deepgram model. Defaults to nova-2.
# DEEPGRAM_MODEL=nova-2

# Optional: the language hint. Defaults to cs (Czech).
# DEEPGRAM_LANGUAGE=cs

# Optional: a YouTube cookies file, for a session the IP is throttled on.
# The path is relative to the repository root. Export it from Firefox
# with the Cookie-Editor extension, in Netscape format.
# YOUTUBE_COOKIES=youtube_cookies.txt